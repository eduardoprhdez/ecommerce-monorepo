{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": false
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.steps.ts",
    "src/**/*.feature"
  ],
  "include": ["src/**/*.ts"]
}
